{
  "name": "mapvibes",
  "version": "1.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite-node scripts/inline-build.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:ui": "vitest run tests/ui",
    "package": "vite-node scripts/package-release.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "gate": "npm run typecheck && npm run lint && npm run format && npm run test:unit && npm run test:ui && npm run build && npx vitest run tests/inline-build"
  },
  "dependencies": {
    "pdfjs-dist": "6.5.438",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "eslint": "10.14.0",
    "jsdom": "^25.0.1",
    "playwright": "1.63.0",
    "prettier": "3.10.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.72.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
